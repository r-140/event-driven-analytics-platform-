{"uid":"semantic-query-service","title":"Semantic Query Service","schemaVersion":41,"version":1,"refresh":"15s","time":{"from":"now-6h","to":"now"},"panels":[
{"id":1,"type":"stat","title":"Query rate","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(semantic_queries_total[5m]))"}],"gridPos":{"h":6,"w":6,"x":0,"y":0}},
{"id":2,"type":"stat","title":"Error rate","fieldConfig":{"defaults":{"unit":"percentunit"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(semantic_queries_total{status=\"error\"}[5m])) / clamp_min(sum(rate(semantic_queries_total[5m])),0.000001)"}],"gridPos":{"h":6,"w":6,"x":6,"y":0}},
{"id":3,"type":"stat","title":"p95 latency","fieldConfig":{"defaults":{"unit":"s"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95,sum by(le)(rate(semantic_query_duration_seconds_bucket[5m])))"}],"gridPos":{"h":6,"w":6,"x":12,"y":0}},
{"id":4,"type":"stat","title":"Average rows returned","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(semantic_query_rows_sum[5m])) / clamp_min(sum(rate(semantic_query_rows_count[5m])),0.000001)"}],"gridPos":{"h":6,"w":6,"x":18,"y":0}},
{"id":5,"type":"timeseries","title":"Latency by semantic model","fieldConfig":{"defaults":{"unit":"s"}},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95,sum by(le,model)(rate(semantic_query_duration_seconds_bucket[5m])))","legendFormat":"{{model}} p95"}],"gridPos":{"h":9,"w":12,"x":0,"y":6}},
{"id":6,"type":"timeseries","title":"Queries by model and status","datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum by(model,status)(rate(semantic_queries_total[5m]))","legendFormat":"{{model}} / {{status}}"}],"gridPos":{"h":9,"w":12,"x":12,"y":6}}
]}
