#!/usr/bin/env bash

set -Eeuo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

readonly GREEN="\033[0;32m"
readonly YELLOW="\033[1;33m"
readonly RED="\033[0;31m"
readonly NC="\033[0m"

info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

usage() {
    cat <<EOF

Usage:

    ./bin/dev build
    ./bin/dev run
    ./bin/dev stop
    ./bin/dev health
    ./bin/dev clean

EOF
}

build() {

    info "Building project..."

    cd "$PROJECT_ROOT"

    mvn clean verify

}

run() {

    info "Starting customer-service..."

    cd "$PROJECT_ROOT/services/customer-service"

    mvn spring-boot:run

}

stop() {

    info "Stopping services..."

    pkill -f CustomerServiceApplication || true

}

health() {

    info "Checking service health..."

    curl \
        --silent \
        http://localhost:8080/actuator/health

    echo

}

clean() {

    info "Cleaning build artifacts..."

    cd "$PROJECT_ROOT"

    mvn clean

}

case "${1:-}" in

    build)
        build
        ;;

    run)
        run
        ;;

    stop)
        stop
        ;;

    health)
        health
        ;;

    clean)
        clean
        ;;

    *)
        usage
        exit 1
        ;;

esac
